generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  username         String?   @unique
  displayName      String?
  firstName        String?
  lastName         String?
  email            String    @unique
  emailVerified    Boolean?  @default(false)
  twoFactorEnabled Boolean?  @default(false)
  phone            String?
  street           String?
  zipCode          String?
  city             String?
  birthDate        DateTime?

  profileImageId String?
  profileImage   Media?  @relation("UserProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)

  // Only with bezirkId, e.g. "Bezirksobmann", "Bezirksobfrau"
  districtRoleName String?

  bezirkId String?

  bio         String?
  preferences Json?

  accounts              Account[]
  sessions              Session[]
  twoFactor             TwoFactor?           @relation("UserTwoFactor")
  bezirk                Bezirk?              @relation("BezirkUsers", fields: [bezirkId], references: [id], onDelete: SetNull)
  uploadedMedia         Media[]              @relation("MediaUploadedBy")
  uploadedDownloads     Download[]           @relation("DownloadUploadedBy")
  posaunenwart          Posaunenwart?        @relation("PosaunenwartUser")
  createdEvents         Event[]              @relation("EventCreator")
  createdCourses        Course[]             @relation("CourseCreator")
  createdPosts          Post[]               @relation("PostCreator")
  authoredPosts         Post[]               @relation("PostAuthor")
  reviewedEvents        Event[]              @relation("EventReviewer")
  reviewedCourses       Course[]             @relation("CourseReviewer")
  reviewedPosts         Post[]               @relation("PostReviewer")
  courseCollaborations  CourseCollaborator[]
  sentCourseMails       CourseMail[]         @relation("CourseMailSender")
  conductedEnsembles    Ensemble[]           @relation("EnsembleConductor")
  representedEnsembles  Ensemble[]           @relation("EnsembleRepresentative")
  conductedAuswahlChors AuswahlChor[]        @relation("AuswahlChorConductor")

  bezirkPersons       BezirkPerson[]       @relation("BezirkPersonUser")
  teamMember          TeamMember?          @relation("TeamMemberUser")
  posaunenratMember   PosaunenratMember?   @relation("PosaunenratMemberUser")
  vorstandMember      VorstandMember?      @relation("VorstandMemberUser")
  foerdervereinMember FoerdervereinMember? @relation("FoerdervereinMemberUser")

  lastLoginAt DateTime?

  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  courseRegistrations  CourseRegistration[]
  savedParticipants    SavedParticipant[]          @relation("SavedParticipants")
  pageViews            PageView[]                  @relation("PageViewUser")
  notifications        Notification[]              @relation("UserNotifications")
  gameNoteSets         GameNoteSet[]               @relation("GameNoteSetCreator")
  customFieldTemplates CourseCustomFieldTemplate[] @relation("CustomFieldTemplateCreator")

  displayUsername String?

  customRoles     UserRoleAssignment[]
  userPermissions UserPermission[]
  bezirkScopes    UserBezirkScope[]    @relation("UserBezirkScopes")

  gameResults GameResult[] @relation("UserGameResults")

  maintenanceUpdates MaintenanceState[] @relation("MaintenanceUpdatedBy")

  createdInvoices   Invoice[] @relation("InvoiceCreator")
  publishedInvoices Invoice[] @relation("InvoicePublisher")
  paidInvoices      Invoice[] @relation("InvoicePayer")

  bookedDownPayments CourseRegistration[] @relation("DownPaymentBooker")

  @@index([bezirkId])
  @@map("user")
}

/**
 * Ein abgeschlossenes Spielergebnis (Spiele unter /spiele).
 * Event-Zeilen statt Aggregaten: Bestwerte und spätere Leaderboards werden per
 * groupBy berechnet; (userId, clientId) macht den Offline-Sync idempotent —
 * die Outbox darf denselben Batch beliebig oft erneut senden.
 */
model GameResult {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserGameResults", fields: [userId], references: [id], onDelete: Cascade)
  game       String // GameId-Slug, im Router gegen die Registry validiert
  score      Int
  maxScore   Int?
  streak     Int?
  durationMs Int?
  meta       Json?
  playedAt   DateTime
  clientId   String
  createdAt  DateTime @default(now())

  @@unique([userId, clientId])
  @@index([userId, game])
  @@index([game, score])
  @@map("game_result")
}


/**
 * Custom Role model for flexible role-based permissions
 * Separate from the UserRole enum to allow custom roles
 */
model Role {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "Content Moderator", "Event Manager"
  description String?
  isSystem    Boolean @default(false) // System roles cannot be deleted

  // Hierarchical role support - roles can inherit from parent roles
  parentRoleId String?
  parentRole   Role?   @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles   Role[]  @relation("RoleHierarchy")

  permissions RolePermission[]

  users UserRoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isSystem])
  @@index([parentRoleId])
  @@map("role")
}

/**
 * Junction table: Role -> Permission
 * Defines which permissions (by key) are assigned to which roles
 * Permissions are hardcoded in the codebase (see src/lib/permissions.ts)
 */
model RolePermission {
  id            String @id @default(uuid())
  roleId        String
  role          Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String // e.g., "events.create", "posts.approve", "users.manage"

  createdAt DateTime @default(now())

  @@unique([roleId, permissionKey])
  @@index([roleId])
  @@index([permissionKey])
  @@map("role_permission")
}

/**
 * Junction table: User -> Role
 * Assigns custom roles to users
 */
model UserRoleAssignment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignment")
}

/**
 * Direct User -> Permission assignment
 * Allows granting specific permissions to individual users, overriding role-based permissions
 * Useful for one-off permissions or user-specific access
 * Permissions are hardcoded in the codebase (see src/lib/permissions.ts)
 */
model UserPermission {
  id            String @id @default(uuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String // e.g., "events.create", "posts.approve", "users.manage"

  // Optional: grant or deny (useful for denying permissions inherited from roles)
  granted Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permissionKey])
  @@index([userId])
  @@index([permissionKey])
  @@index([granted])
  @@map("user_permission")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String   @id
  userId      String   @unique
  user        User     @relation("UserTwoFactor", fields: [userId], references: [id], onDelete: Cascade)
  secret      String? //@db.Text
  backupCodes String? //@db.Text
  verified    Boolean? @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Account lockout counters required by better-auth >= 1.6.25 — the plugin
  // updates these on every sign-in verification (even successful ones).
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@map("twoFactor")
}


enum EventEnsembleType {
  AUSWAHLCHOR
  ENSEMBLE
  CUSTOM
}

enum EventCategory {
  KONZERT // Concert
  GOTTESDIENST // Church service
  PROBE // Rehearsal
  ANDERE // Other
}

enum CourseType {
  LEHRGANG // Course/Training
  FREIZEIT // Retreat
  WORKSHOP
  KOMPONISTENPORTRAIT // Composer Portrait
  VERANSTALTUNG // Event
  OTHER
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  CHECKBOX
  TEXTAREA
  DATE
  YEAR
  TIME
  MULTISELECT
  PHONE
  EMAIL
}

/**
 * Kurs-Team: Organizer bearbeitet den Kurs; Team sieht Teilnehmer (ohne volle Bearbeitung).
 */
enum CourseCollaboratorRole {
  ORGANIZER
  STAFF
}

enum CoursePaymentMethod {
  CASH // Barzahlung vor Ort
  INVOICE // Überweisung nach Rechnung
}

/**
 * Lebenszyklus einer Rechnung. DRAFT ist frei editierbar und trägt noch keine
 * Rechnungsnummer; ab PUBLISHED ist das Dokument unveränderlich (§14 UStG) und
 * wird nur noch per Storno + Neuausstellung korrigiert.
 */
enum InvoiceStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum PostCategory {
  MAGAZIN // Magazine
  EVENT // Event
  AUSBILDUNG // Education/Training
  BEZIRKE // Districts
  ANDERE // Other
}

enum TargetAudience {
  ANFAENGER // Beginners
  FORTGESCHRITTENE // Advanced
  DIRIGENTEN // Conductors
  JUGEND // Youth
  ALLE // All
}

enum RegistrationStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum SiblingDiscountStatus {
  NONE // No discount applied
  PENDING // Discount applied, awaiting review
  APPROVED // Discount approved
  REJECTED // Discount rejected
}

/**
 * Woran sich die Anzahlung eines Kurses bemisst: ein fester Betrag pro
 * Teilnehmer für alle Kategorien (COURSE) oder je Preiskategorie (TICKET).
 */
enum DownPaymentMode {
  NONE
  COURSE
  TICKET
}

/** Welcher Hinweis zur Erstattung bei der Anmeldung bestätigt werden muss. */
enum DownPaymentRefundPolicy {
  NON_REFUNDABLE
  REFUNDABLE
  CUSTOM
}

/**
 * Stand der Anzahlung einer Anmeldung. REFUNDED und RETAINED sind die beiden
 * Ausgänge nach einer Stornierung — welcher gilt, klärt das Kursteam mit der
 * Kasse, deshalb setzt die Stornierung ihn nicht selbst.
 */
enum DownPaymentStatus {
  OPEN
  PAID
  REFUNDED
  RETAINED
}

enum PosaunenwartRoleType {
  LPW // Landesposaunenwart (responsible for all Bezirke)
  RPW // Regionalposaunenwart (responsible for multiple Bezirke)
}

enum ContactType {
  GESCHAEFTSSTELLE
  INTERNET_TEAM
}

enum PosaunenratRole {
  VORSTAND
  LANDESKIRCHENMUSIKDIREKTOR
  LANDESKIRCHENMUSIKDIREKTORIN
  SACHVERSTAENDIGER
  SACHVERSTAENDIGE
}

enum FoerdervereinRole {
  VORSITZENDER // Chairman
  STELLVERTRETER // Vice Chairman
  SCHATZMEISTER // Treasurer
  SCHRIFTFUEHRER // Secretary
  BEISITZER // Board Member
  MITGLIED // Regular Member
}

enum HistoryCategory {
  FOUNDING
  MILESTONE
  EXPANSION
  MODERNIZATION
  PARTNERSHIP
}

enum DownloadCategory {
  BLECHBLATT // Rheinisches Blechblatt
  NOTEN // Sheet music
  UEBUNGEN // Exercises
  FORMULARE // Forms
  SONSTIGES // Other
}

enum FileType {
  PDF
  DOCX
  XLSX
  ZIP
  MP3
  IMAGE // JPG, PNG oder WebP – z. B. Flyer an Terminen
}

enum ContentStatus {
  DRAFT // Being worked on
  PENDING // Submitted, waiting for approval
  APPROVED // Approved and published
  REJECTED // Rejected, needs revision
  ARCHIVED // No longer active
}


model Event {
  id          String  @id @default(uuid())
  /**
   * URL identifier derived from the title and year; see Post.slug.
   */
  slug        String? @unique
  title       String
  motto       String?
  description String?

  coverImageId String?
  coverImage   Media?  @relation("EventCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  eventDate DateTime
  duration  Int?
  cancelled Boolean  @default(false)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  category     EventCategory
  bezirkId     String?
  districtName String?

  performingEnsembleType EventEnsembleType?
  ensembleId             String?
  auswahlChorId          String?
  performingEnsembleName String?
  leitung                String?

  openToParticipants Boolean @default(false)
  participationInfo  String?

  isFree    Boolean @default(true)
  priceInfo String?

  // Approval Workflow — single source of truth
  status      ContentStatus @default(PENDING)
  reviewNotes String?
  reviewDate  DateTime?

  ensemble     Ensemble?          @relation(fields: [ensembleId], references: [id], onDelete: SetNull)
  auswahlChor  AuswahlChor?       @relation(fields: [auswahlChorId], references: [id], onDelete: SetNull)
  bezirk       Bezirk?            @relation(fields: [bezirkId], references: [id], onDelete: SetNull)
  priceOptions EventPriceOption[]
  downloads    EventDownload[]

  createdById String?
  createdBy   User?     @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewerId  String?
  reviewer    User?     @relation("EventReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([eventDate])
  @@index([status])
  @@index([category])
  @@index([bezirkId])
  @@index([status, eventDate])
  @@index([createdById])
}

model EventPriceOption {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  price       Float
  label       String
  description String?

  @@index([eventId])
}

model EventDownload {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  downloadId String
  download   Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, downloadId])
  @@index([eventId])
  @@index([downloadId])
}

model Course {
  id          String  @id @default(uuid())
  /**
   * URL identifier derived from the title and year; see Post.slug.
   */
  slug        String? @unique
  title       String
  motto       String?
  description String

  /**
   * Interne Kursnummer (nur Ziffern), ausschließlich für die Rechnungsstellung:
   * sie bildet den mittleren Teil der Rechnungsnummer (RE-<Kursnummer>-<lfd.>)
   * und steht im Verwendungszweck, damit Zahlungseingänge einem Kurs zugeordnet
   * werden können. Optional — ohne Nummer bleibt es bei der Jahresnummerierung.
   */
  courseNumber String? @unique

  imageId String?
  image   Media?  @relation("CourseImage", fields: [imageId], references: [id], onDelete: SetNull)

  startDate DateTime
  endDate   DateTime

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  courseType     CourseType
  targetAudience TargetAudience?
  bezirkId       String?

  registrationOpen             Boolean   @default(false)
  registrationOpensAt          DateTime? // When registrations become available (details visible before this)
  registrationDeadline         DateTime?
  /**
   * When set, registration happens on an external provider website instead of this platform.
   */
  externalProviderName         String?
  externalRegistrationUrl      String?
  /**
   * When the post-deadline overview e-mail was sent to creator/organizers.
   */
  registrationClosedNotifiedAt DateTime?
  maxParticipants              Int? // optional hard cap
  allowWaitingList             Boolean   @default(false)

  isFree                Boolean @default(false)
  priceInfo             String?
  allowSiblingDiscount  Boolean @default(false) // Förderverein sibling discount (20% for siblings after first)
  /**
   * Welche Zahlungsweisen Teilnehmer bei kostenpflichtigen Kursen nutzen dürfen (mindestens eine, wenn nicht kostenlos).
   */
  paymentCashAllowed    Boolean @default(true)
  paymentInvoiceAllowed Boolean @default(true)
  /**
   * Ob für diesen Kurs überhaupt Rechnungen erstellt werden dürfen. Getrennt von
   * paymentInvoiceAllowed (Wunsch-Zahlungsweise der Anmeldung) und nur mit
   * courses.enable_invoicing setzbar.
   */
  invoicingEnabled      Boolean @default(false)

  /**
   * Anzahlung, die bei der Anmeldung per Überweisung fällig wird. Nur mit
   * courses.enable_down_payment setzbar, verlangt eine Kursnummer (sie steht im
   * Verwendungszweck) und ist gesperrt, solange aktive Anmeldungen bestehen.
   * Bei TICKET trägt jede Preiskategorie ihren eigenen Betrag.
   */
  downPaymentMode         DownPaymentMode         @default(NONE)
  /** Betrag pro Teilnehmer bei DownPaymentMode.COURSE. */
  downPaymentAmount       Float?
  downPaymentRefundPolicy DownPaymentRefundPolicy @default(NON_REFUNDABLE)
  /** Eigener Erstattungshinweis bei DownPaymentRefundPolicy.CUSTOM. */
  downPaymentRefundText   String?

  prerequisites String?
  whatToBring   String?

  status      ContentStatus @default(PENDING)
  reviewNotes String?
  reviewDate  DateTime?

  collaborators    CourseCollaborator[]
  guestTeamMembers CourseGuestTeamMember[]
  bezirk           Bezirk?                 @relation(fields: [bezirkId], references: [id], onDelete: SetNull)
  priceOptions     CoursePriceOption[] // Each can have their own maxParticipants
  customFields     CourseCustomField[]
  registrations    CourseRegistration[]
  mails            CourseMail[]
  invoices         Invoice[]

  createdById String?
  createdBy   User?     @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewerId  String?
  reviewer    User?     @relation("CourseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate])
  @@index([courseType])
  @@index([bezirkId])
  @@index([status, endDate])
  @@index([createdById])
}

model CourseCollaborator {
  id       String                 @id @default(uuid())
  courseId String
  course   Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CourseCollaboratorRole

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
  @@map("course_collaborator")
}

/// Public-facing team line only (no login, no dashboard access)
model CourseGuestTeamMember {
  id          String  @id @default(uuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?
  sortOrder   Int     @default(0)

  @@index([courseId])
  @@map("course_guest_team_member")
}

model CoursePriceOption {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  price           Float
  label           String
  description     String?
  maxParticipants Int?

  /**
   * Altersgrenzen in vollendeten Jahren, jeweils einschließlich. Stichtag ist
   * der erste Kurstag — nicht der Tag der Anmeldung, sonst rutschte ein
   * Teilnehmer zwischen Anmeldung und Kurs aus seiner Kategorie und der Preis
   * stimmte nachträglich nicht mehr.
   * Bewusst pro Kategorie statt einer globalen Jugend-Definition: ab wann
   * jemand als erwachsen gilt, ist von Haus zu Haus verschieden (mal ab 18,
   * mal erst ab 27). Beide Werte sind optional — nur `minAge` heißt „ab“, nur
   * `maxAge` heißt „bis“.
   */
  minAge Int?
  maxAge Int?

  /**
   * Anzahlung pro Teilnehmer dieser Kategorie, nur bei Course.downPaymentMode
   * TICKET. Leer heißt: für diese Kategorie wird keine Anzahlung fällig.
   */
  downPaymentAmount Float?

  participants Participant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model CourseCustomField {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  fieldName  String
  fieldType  CustomFieldType
  options    Json? // JSON for select options
  isRequired Boolean         @default(false)
  helpText   String?
  sortOrder  Int             @default(0)

  @@index([courseId])
}

/// Reusable registration fields, copied into CourseCustomField so template edits never affect courses.
/// Private to the creator until a course containing the field is approved (isGlobal).
model CourseCustomFieldTemplate {
  id String @id @default(uuid())

  fieldName  String
  fieldType  CustomFieldType
  options    Json? // JSON for select options (same shape as CourseCustomField)
  isRequired Boolean         @default(false)
  helpText   String?
  isGlobal   Boolean         @default(false)

  createdById String?
  createdBy   User?   @relation("CustomFieldTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([fieldName])
  @@map("course_custom_field_template")
}

model CourseRegistration {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  registrantFirstName String
  registrantLastName  String
  registrantEmail     String
  registrantPhone     String?
  registrantStreet    String?
  registrantZipCode   String?
  registrantCity      String?
  registrantId        String?
  useSeparateBilling  Boolean @default(false)
  billingCompany      String?
  billingFirstName    String?
  billingLastName     String?
  billingStreet       String?
  billingZipCode      String?
  billingCity         String?
  billingEmail        String?

  totalPrice         Float
  /**
   * Gewünschte Zahlungsweise (Bar / Rechnung), sofern der Kurs kostenpflichtig ist.
   */
  paymentMethod      CoursePaymentMethod?
  registrationStatus RegistrationStatus   @default(CONFIRMED)

  siblingDiscountApplied Boolean               @default(false)
  siblingDiscountStatus  SiblingDiscountStatus @default(NONE)
  originalTotalPrice     Float? // Price before discount
  siblingDiscountAmount  Float? // Discount amount (20% for each sibling after first)

  /**
   * Anzahlung dieser Anmeldung, bei Anmeldung aus den Kurseinstellungen
   * berechnet und festgehalten. null heißt: keine Anzahlung — dann gelten die
   * üblichen Regeln zum Bearbeiten und Stornieren.
   */
  downPaymentAmount     Float?
  /** null genau dann, wenn downPaymentAmount null ist. */
  downPaymentStatus     DownPaymentStatus?
  downPaymentPaidAt     DateTime?
  /** Tatsächlich eingegangener Betrag; null heißt "voller Betrag" (wie Invoice.paidAmount). */
  downPaymentPaidAmount Float?
  downPaymentPaidById   String?
  downPaymentPaidBy     User?              @relation("DownPaymentBooker", fields: [downPaymentPaidById], references: [id], onDelete: SetNull)
  /** Interner Vermerk (Kontoauszug, Absprache mit der Kasse zur Erstattung). */
  downPaymentNote       String?

  invoiceGenerated Boolean   @default(false)
  invoiceId        String?   @unique
  invoiceDate      DateTime?

  /**
   * Teile einer aufgeteilten Anmeldung tragen dieselbe Gruppe: reichten die
   * freien Plätze nicht für alle, wurden die Gewählten bestätigt und die
   * übrigen auf die Warteliste gesetzt — als eigene Anmeldungen, weil
   * Kapazität, Rechnungen und Anzahlung an der Anmeldung hängen. Der
   * Geschwisterkindrabatt wird über die Gruppe berechnet. null: nicht geteilt.
   */
  registrationGroupId String?

  /**
   * Nachrück-Angebot: Es wurden Plätze frei, die nicht für alle Teilnehmer
   * dieser wartenden Anmeldung reichen. Bis zu diesem Zeitpunkt wählen die
   * Anmeldenden, wer nachrückt — so lange hält die Warteliste an.
   */
  promotionOfferExpiresAt      DateTime?
  /** Wann das Kursteam an das auslaufende Angebot erinnert wurde. */
  promotionOfferReminderSentAt DateTime?
  /**
   * Angebot abgelehnt oder verfallen, als so viele Plätze nutzbar waren: bis
   * mehr frei werden, gehen sie an die Nächsten auf der Warteliste.
   */
  promotionOfferPassedSeats    Int?

  participants Participant[]
  invoices     Invoice[]
  registrant   User?         @relation(fields: [registrantId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationStatus])
  @@index([siblingDiscountStatus])
  @@index([courseId, registrationStatus])
  @@index([registrantId])
  @@index([registrationGroupId])
  @@index([promotionOfferExpiresAt])
}

/// Archived e-mail from an organizer to a course's registrants. Recipient addresses are
/// deliberately not stored, only the count, so registrant data isn't duplicated.
model CourseMail {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Sender is snapshotted as well: the entry stays readable after the user is deleted.
  senderId     String?
  sender       User?   @relation("CourseMailSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName   String
  senderEmail  String
  /// Where replies go. Defaults to the sender's address, editable when composing.
  replyToEmail String

  subject String
  /// Markdown as produced by the dashboard editor; rendered to HTML per recipient.
  body    String

  /// Who it went to: { statuses: RegistrationStatus[], registrationIds: string[] }
  recipientFilter Json
  /// [{ filename, url, size }] — files attached to the outgoing mail.
  attachments     Json?

  recipientCount Int
  sentCount      Int
  failedCount    Int @default(0)

  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
  @@index([senderId])
  @@map("course_mail")
}

/// Continuous invoice numbering per year (§14 UStG requires an unbroken
/// sequence). Incremented atomically inside the invoice-issuing transaction.
model InvoiceCounter {
  year  Int @id
  value Int @default(0)
}

/// Fortlaufende Rechnungsnummer je `Course.courseNumber`. Eigene Tabelle, weil der Zähler wie
/// {@link InvoiceCounter} in der Ausstell-Transaktion gesperrt und beim Rollback zurückgedreht wird.
model CourseInvoiceCounter {
  courseNumber String @id
  value        Int    @default(0)
}

/// Rechnung zu einer Kursanmeldung; nach dem Vorbefüllen eigenständig editierbar (Nachlass, Anzahlung).
/// Ab `PUBLISHED` eingefroren: Nummer vergeben, PDF nie überschrieben. Korrekturen per Storno
/// (`CANCELLED`) plus Nachfolgerechnung, die über `replacesInvoiceId` zurückzeigt.
model Invoice {
  id String @id @default(uuid())

  /// Fortlaufende Nummer, erst beim Veröffentlichen vergeben (Entwürfe: null).
  invoiceNumber String? @unique

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Bleibt erhalten, wenn die Anmeldung gelöscht wird — die Rechnung ist
  /// aufbewahrungspflichtig, die Empfängerdaten stehen ohnehin hier.
  registrationId String?
  registration   CourseRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  status InvoiceStatus @default(DRAFT)

  // Rechnungsempfänger (Snapshot, editierbar)
  recipientCompany   String?
  recipientFirstName String?
  recipientLastName  String?
  recipientStreet    String?
  recipientZipCode   String?
  recipientCity      String?
  recipientEmail     String?

  /// Positionen: [{ description, detail, quantity, unitPrice }] — unitPrice darf
  /// negativ sein (Rabatte, Anzahlungen).
  lineItems   Json
  /// Summe der Positionen zum Zeitpunkt des letzten Speicherns.
  totalAmount Float @default(0)

  invoiceDate DateTime?
  dueDate     DateTime?

  introText     String?
  closingText   String?
  signatureName String?
  /// Interne Notiz, erscheint nicht auf dem PDF.
  internalNote  String?

  // Storno-Kette
  cancelledAt       DateTime?
  cancelReason      String?
  replacesInvoiceId String?   @unique
  replaces          Invoice?  @relation("InvoiceSuccession", fields: [replacesInvoiceId], references: [id], onDelete: SetNull)
  replacedBy        Invoice?  @relation("InvoiceSuccession")

  /// Abgelegtes Dokument, z.B. "/api/uploads/invoices/RE-2026-00042.pdf".
  pdfPath     String?
  pdfFilename String?

  publishedAt DateTime?
  /// Wann die Anmelder:innen über die Rechnung benachrichtigt wurden.
  notifiedAt  DateTime?
  /// Wann die Rechnung zuletzt per Kursmail verschickt wurde.
  mailedAt    DateTime?

  /// Einzige Wahrheit über den Zahlungseingang; der Dokumentstatus bleibt unberührt,
  /// weil §14 UStG das ausgestellte Dokument einfriert.
  paidAt      DateTime?
  /// Tatsächlich eingegangener Betrag. Weicht bei Teilzahlung von
  /// `totalAmount` ab; null bedeutet "voller Betrag".
  paidAmount  Float?
  paidById    String?
  paidBy      User?     @relation("InvoicePayer", fields: [paidById], references: [id], onDelete: SetNull)
  /// Interner Vermerk zur Zahlung (Kontoauszug, Barzahlung, Kulanz).
  paymentNote String?

  createdById   String?
  createdBy     User?   @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedById String?
  publishedBy   User?   @relation("InvoicePublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, status])
  @@index([registrationId])
  @@index([status, publishedAt])
  @@index([courseId, paidAt])
  @@index([createdById])
  @@index([createdAt])
  @@map("invoice")
}

model Participant {
  id             String             @id @default(uuid())
  registrationId String
  registration   CourseRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  firstName      String
  lastName       String
  birthDate      DateTime
  city           String
  instrument     String?
  /**
   * Gewählte Preiskategorie. Führend für Belegung und Kapazität — das Label
   * allein taugt dafür nicht, weil ein Kurs zwei Kategorien mit demselben
   * Namen führen darf (etwa dieselbe Zimmerart in zwei Häusern).
   * Bleibt bei gelöschter Kategorie null; `priceOption` hält den Namen dann
   * weiterhin fest.
   */
  priceOptionId  String?
  priceOptionRef CoursePriceOption? @relation(fields: [priceOptionId], references: [id], onDelete: SetNull)
  /**
   * Name der Kategorie zum Zeitpunkt der Anmeldung — Anzeige-Snapshot für
   * Listen, Exporte und Rechnungen. Bewusst nicht führend: er darf sich
   * nachträglich vom aktuellen Label unterscheiden.
   */
  priceOption    String?
  customFields   Json? // JSON for custom field values
  siblingGroupId String? // Groups siblings together for discount calculation (same ID = siblings)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([priceOption])
  @@index([priceOptionId])
}

model SavedParticipant {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("SavedParticipants", fields: [userId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  birthDate    DateTime
  city         String
  instrument   String?
  customFields Json? // JSON for custom field values that can be reused

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Location {
  id             String  @id @default(uuid())
  name           String? // e.g., "Gemeindehaus Köln-Deutz"
  street         String?
  zipCode        String?
  city           String
  country        String? @default("Deutschland")
  additionalInfo String? // e.g., "Eingang über den Hinterhof"

  latitude  Float?
  longitude Float?

  events    Event[]
  courses   Course[]
  ensembles Ensemble[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([zipCode])
}

model Post {
  id      String  @id @default(uuid())
  /**
   * URL identifier derived from the title. Nullable so the column could be
   * added without downtime; the detail route still resolves plain UUIDs and
   * redirects them here, so links shared before the backfill keep working.
   */
  slug    String? @unique
  title   String
  excerpt String?
  content String // Rich text/Markdown

  coverImageId        String?
  coverImage          Media?  @relation("PostCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  coverImagePositionX Float? // Focal point X position (0-100, percentage)
  coverImagePositionY Float? // Focal point Y position (0-100, percentage)

  category PostCategory
  bezirkId String?
  bezirk   Bezirk?      @relation(fields: [bezirkId], references: [id], onDelete: SetNull)

  // Author (optional - if not set, createdBy is used as author)
  authorId   String?
  author     User?   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String? // Custom author name if not linked to a user

  pinned Boolean @default(false)

  status      ContentStatus @default(PENDING)
  reviewNotes String?
  reviewDate  DateTime?

  createdById String?
  createdBy   User?     @relation("PostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewerId  String?
  reviewer    User?     @relation("PostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([bezirkId])
  @@index([status])
  @@index([status, pinned, createdAt])
  @@index([createdById])
}

model Ensemble {
  id          String  @id @default(uuid())
  /**
   * URL identifier derived from the name; see Post.slug.
   */
  slug        String? @unique
  name        String
  description String?

  // Chor-Nr from the Posaunenwerk-wide registry, e.g. "13-01"
  internalId String? @unique

  bezirkId String?
  bezirk   Bezirk? @relation(fields: [bezirkId], references: [id], onDelete: SetNull)

  imageId String?
  image   Media?  @relation("EnsembleImage", fields: [imageId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  rehearsalSchedules RehearsalSchedule[]

  // Legacy fields (deprecated - kept for migration)
  rehearsalDay  String? // e.g., "Montag", "Dienstag", etc.
  rehearsalTime String? // e.g., "19:30", "20:00-21:30"

  contactWebsite String?
  /**
   * JSON array of social links, same shape as TeamMember.socials:
   * [{ type: "instagram", url: "https://…", label?: "…" }]. The known types
   * are SOCIAL_TYPE_OPTIONS in app/_components/ui/social-icon.tsx.
   */
  socials        Json?

  // Conductor (Leitung). Either link to a User (preferred) or provide
  // free-text name/email/phone for non-user conductors.
  conductorId    String?
  conductor      User?   @relation("EnsembleConductor", fields: [conductorId], references: [id], onDelete: SetNull)
  conductorName  String?
  conductorEmail String?
  conductorPhone String?

  // Representative (Ansprechpartner). Defaults to conductor if not set.
  representativeId    String?
  representative      User?   @relation("EnsembleRepresentative", fields: [representativeId], references: [id], onDelete: SetNull)
  representativeName  String?
  representativeEmail String?
  representativePhone String?

  isActive Boolean @default(true)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bezirkId])
  @@index([isActive])
}

model RehearsalSchedule {
  id         String   @id @default(uuid())
  ensembleId String
  ensemble   Ensemble @relation(fields: [ensembleId], references: [id], onDelete: Cascade)

  day  String // e.g., "Montag", "Dienstag", "Samstag", etc.
  time String // e.g., "19:30", "20:00-21:30", "8:00-12:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ensembleId])
}

model AuswahlChor {
