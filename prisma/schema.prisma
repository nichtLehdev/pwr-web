  name     String // Original filename
  filename String @unique // Stored filename (with timestamp/hash)
  url      String // Public URL to access file
  path     String // Storage path

  mimeType  String // image/jpeg, application/pdf, etc.
  size      Int // Size in bytes
  extension String // jpg, png, pdf, etc.

  width  Int?
  height Int?

  // Focal point for object-position when displayed as cover (0-100%)
  focalPointX Float?
  focalPointY Float?

  alt       String? // Alt text for images
  caption   String? // Caption/description
  title     String? // Title
  copyright String? // Optional copyright notice
  creator   String? // Optional photographer/creator name

  folder String? // Folder path (e.g., "events/2025", "news")
  tags   Json? // JSON array of tags

  isPublic    Boolean       @default(true)
