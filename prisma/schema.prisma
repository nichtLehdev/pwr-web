model Blaeserheft {
  id          String @id @default(uuid())
  title       String
  subtitle    String
  year        Int
  description String

  // Details
  chapters   Json? // JSON array
  highlights Json? // JSON array

  imageId     String
  image       Media   @relation("BlaeserheftImage", fields: [imageId], references: [id], onDelete: Cascade)
  audioSample String?

  // Prices
  priceBlaeserheft Float?
  priceBeiheft     Float?
  priceTrompeten   Float?
  priceCd          Float?

  // Availability
  availableBlaeserheft Boolean @default(true)
  availableBeiheft     Boolean @default(true)
  availableTrompeten   Boolean @default(false)
  availableCd          Boolean @default(true)

  // Sorting
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
}

model Media {
  id String @id @default(uuid())

  // File Info
  name     String // Original filename
  filename String @unique // Stored filename (with timestamp/hash)
  url      String // Public URL to access file
  path     String // Storage path

  // File Details
  mimeType  String // image/jpeg, application/pdf, etc.
  size      Int // Size in bytes
  extension String // jpg, png, pdf, etc.

  // Image-specific (nullable for non-images)
  width  Int?
  height Int?

  // Focal point for object-position when displayed as cover (0-100%)
  focalPointX Float?
  focalPointY Float?

  // Metadata
  alt       String? // Alt text for images
  caption   String? // Caption/description
  title     String? // Title
  copyright String? // Optional copyright notice
  creator   String? // Optional photographer/creator name

  // Organization
  folder String? // Folder path (e.g., "events/2025", "news")
  tags   Json? // JSON array of tags

  // Usage tracking & Review
  isPublic    Boolean       @default(true)
  status      ContentStatus @default(APPROVED) // Default to APPROVED for backwards compatibility
  reviewNotes String?

  // Relations - primary usages (kept explicit)
  usersProfile            User[]                 @relation("UserProfileImage")
  eventsCover             Event[]                @relation("EventCoverImage")
  postsCover              Post[]                 @relation("PostCoverImage")
  ensembleImages          Ensemble[]             @relation("EnsembleImage")
  auswahlChorImages       AuswahlChor[]          @relation("AuswahlChorImage")
  teamMemberImages        TeamMember[]           @relation("TeamMemberImage")
  bezirkPersonImages      BezirkPerson[]         @relation("BezirkPersonImage")
  vorstandMemberImages    VorstandMember[]       @relation("VorstandMemberImage")
  posaunenratMemberImages PosaunenratMember[]    @relation("PosaunenratMemberImage")
  foerdervereinMemberImgs FoerdervereinMember[]  @relation("FoerdervereinMemberImage")
  posaunenwartImages      Posaunenwart[]         @relation("PosaunenwartImage")
  historyEventImages      HistoryEvent[]         @relation("HistoryEventImage")
  blaeserheftImages       Blaeserheft[]          @relation("BlaeserheftImage")
  courseImages            Course[]               @relation("CourseImage")
  homepageCarouselItems   HomepageCarouselItem[] @relation("HomepageCarouselMedia")

  // Uploaded by
  uploadedById String?
  uploadedBy   User?   @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mimeType])
  @@index([folder])
  @@index([uploadedById])
  @@index([status])
  @@index([url])
}

/// Newsletter recipients. `isActive` says the address wants the newsletter;
/// `confirmedAt` says the address proved it does (double opt-in). Both must
/// hold before anything is sent — an unconfirmed row is only a pending
/// sign-up, and anyone can create one for an address they do not own.
model NewsletterSubscriber {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  isActive Boolean @default(true)

  /// Null until the confirmation link from the opt-in mail was opened.
  confirmedAt    DateTime?
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([isActive, confirmedAt])
}

model HomepageCarouselItem {
  id String @id @default(uuid())

  mediaId String
  media   Media  @relation("HomepageCarouselMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  title    String? // Custom title (replaces "Posaunenwerk Rheinland")
  subtitle String? // Custom subtitle (replaces "Gemeinsam Musik machen, Glauben leben")

  isActive  Boolean @default(true)
  sortOrder Int     @default(0) // Lower number = appears first

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

// Page/section views for statistics. Anonymous unless user opted in to "track by user".
model PageView {
  id        String   @id @default(uuid())
  path      String // e.g. "/", "/aktuelles", "/termine"
  section   String? // optional: "hero", "footer", "sidebar", etc.
  userId    String? // set when user consented to "track views by user"
  user      User?    @relation("PageViewUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([path])
  @@index([section])
  @@index([createdAt])
  @@index([userId])
  @@index([createdAt, path])
  @@index([userId, createdAt])
  @@map("page_view")
}

/// Storage for better-auth's built-in rate limiter (rateLimit.storage =
/// "database"), so login/reset throttling survives restarts and works
/// across multiple instances.
model RateLimit {
  id          String  @id
  key         String?
  count       Int?
  lastRequest BigInt?

  @@index([key])
  @@map("rateLimit")
}

/// Immutable record of security-relevant actions: who changed what, when.
/// Written fire-and-forget by logAudit(); never updated or deleted by the app.
model AuditLog {
  id         String   @id @default(uuid())
  /// Acting user; kept as plain id (no FK) so log entries survive user deletion.
  actorId    String?
  actorEmail String?
  action     String // e.g. "role.assign", "registration.payment_status", "user.delete"
  entityType String // e.g. "user", "course", "registration", "role"
  entityId   String?
  /// Human-readable summary and/or structured before/after values.
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_log")
}

/// In-app notifications shown in the header bell. One row per recipient.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  /// e.g. "review.approved", "review.rejected", "review.submitted", "registration.new"
  type  String
  title String
  body  String?
  /// Internal path to open when clicked, e.g. "/dashboard/posts/123"
  url   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

/// Public library of user-created note sets for the games under /spiele.
/// A set is a named list of spelled written pitches in one clef; each game
/// decides itself whether/how it can play the set (e.g. Griffe checks
/// fingering coverage per instrument).
model GameNoteSet {
  id       String @id @default(uuid())
  /// Short URL-safe code used for deep links (?set=...), e.g. "k3f7x9q2".
  publicId String @unique

  name        String
  description String?
  /// "treble" | "bass" | "alto" | "tenor"
  clef        String
  /// Array of written pitches: { letter: "C".."H", alter: -1|0|1, octave: number }
  pitches     Json

  creatorId String?
  creator   User?   @relation("GameNoteSetCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  /// Incremented when a set is activated in a game (rough popularity signal).
  timesUsed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clef])
  @@index([creatorId])
  @@index([createdAt])
  @@index([timesUsed])
  @@map("game_note_set")
}
