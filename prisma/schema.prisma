  reviewNotes String?

  usersProfile            User[]                 @relation("UserProfileImage")
  eventsCover             Event[]                @relation("EventCoverImage")
  postsCover              Post[]                 @relation("PostCoverImage")
  ensembleImages          Ensemble[]             @relation("EnsembleImage")
  auswahlChorImages       AuswahlChor[]          @relation("AuswahlChorImage")
  teamMemberImages        TeamMember[]           @relation("TeamMemberImage")
  bezirkPersonImages      BezirkPerson[]         @relation("BezirkPersonImage")
  vorstandMemberImages    VorstandMember[]       @relation("VorstandMemberImage")
  posaunenratMemberImages PosaunenratMember[]    @relation("PosaunenratMemberImage")
  foerdervereinMemberImgs FoerdervereinMember[]  @relation("FoerdervereinMemberImage")
  posaunenwartImages      Posaunenwart[]         @relation("PosaunenwartImage")
  historyEventImages      HistoryEvent[]         @relation("HistoryEventImage")
  blaeserheftImages       Blaeserheft[]          @relation("BlaeserheftImage")
  courseImages            Course[]               @relation("CourseImage")
  homepageCarouselItems   HomepageCarouselItem[] @relation("HomepageCarouselMedia")

  uploadedById String?
  uploadedBy   User?   @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mimeType])
  @@index([folder])
  @@index([uploadedById])
  @@index([status])
  @@index([url])
}

/// Send only if `isActive` (wants it) and `confirmedAt` (double opt-in) both hold:
/// anyone can create an unconfirmed row for an address they do not own.
model NewsletterSubscriber {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  isActive Boolean @default(true)

  /// Null until the confirmation link from the opt-in mail was opened.
  confirmedAt    DateTime?
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  /// Einwilligungsnachweis (Art. 7 Abs. 1 DSGVO): IPs von Anmeldung und Bestätigung plus
  /// Fassung des Einwilligungstextes. Bei Abmeldung leeren, die IP darf nicht bleiben.
  signupIp       String?
  confirmIp      String?
  consentVersion String?

  @@index([isActive, confirmedAt])
}

/// Einzeiliger Datensatz (id = 1) fuer den Wartungsmodus.
/// MAINTENANCE_MODE hat Vorrang und kommt ohne Datenbank aus.
model MaintenanceState {
  id      Int     @id @default(1)
  enabled Boolean @default(false)

  message String?

  /// Rein informativ. Es schaltet sich nichts automatisch wieder ein.
  until DateTime?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("MaintenanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("maintenance_state")
}

model HomepageCarouselItem {
  id String @id @default(uuid())

  mediaId String
  media   Media  @relation("HomepageCarouselMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  title    String? // Custom title (replaces "Posaunenwerk Rheinland")
  subtitle String? // Custom subtitle (replaces "Gemeinsam Musik machen, Glauben leben")

  isActive  Boolean @default(true)
  sortOrder Int     @default(0) // Lower number = appears first

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

// Page/section views for statistics. Anonymous unless user opted in to "track by user".
model PageView {
  id        String   @id @default(uuid())
  path      String // e.g. "/", "/aktuelles", "/termine"
  section   String? // optional: "hero", "footer", "sidebar", etc.
  userId    String? // set when user consented to "track views by user"
  user      User?    @relation("PageViewUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([path])
  @@index([section])
  @@index([createdAt])
  @@index([userId])
  @@index([createdAt, path])
  @@index([userId, createdAt])
  @@map("page_view")
}

/// better-auth rate limiter storage (rateLimit.storage = "database"), so throttling
/// survives restarts and works across instances.
model RateLimit {
  id          String  @id
  key         String?
  count       Int?
  lastRequest BigInt?

  @@index([key])
  @@map("rateLimit")
}

/// Immutable record of security-relevant actions: who changed what, when.
/// Written fire-and-forget by logAudit(); never updated or deleted by the app.
model AuditLog {
  id         String   @id @default(uuid())
  /// Acting user; kept as plain id (no FK) so log entries survive user deletion.
  actorId    String?
  actorEmail String?
  action     String // e.g. "role.assign", "registration.payment_status", "user.delete"
  entityType String // e.g. "user", "course", "registration", "role"
  entityId   String?
  /// Human-readable summary and/or structured before/after values.
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_log")
}

/// In-app notifications shown in the header bell. One row per recipient.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  /// e.g. "review.approved", "review.rejected", "review.submitted", "registration.new"
  type  String
  title String
  body  String?
  /// Internal path to open when clicked, e.g. "/dashboard/posts/123"
  url   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

/// User-created note sets (written pitches in one clef) for the games under /spiele.
/// Each game decides whether it can play a set (e.g. Griffe checks fingering coverage).
model GameNoteSet {
  id       String @id @default(uuid())
  /// Short URL-safe code used for deep links (?set=...), e.g. "k3f7x9q2".
  publicId String @unique

  name        String
  description String?
  /// "treble" | "bass" | "alto" | "tenor"
  clef        String
  /// Array of written pitches: { letter: "C".."H", alter: -1|0|1, octave: number }
  pitches     Json

  creatorId String?
  creator   User?   @relation("GameNoteSetCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  /// Incremented when a set is activated in a game (rough popularity signal).
  timesUsed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clef])
  @@index([creatorId])
  @@index([createdAt])
  @@index([timesUsed])
  @@map("game_note_set")
}
