model Bezirk {
  id        String @id @default(uuid())
  number    Int    @unique // 1-13
  name      String // "Bezirk 01 - Unterer Niederrhein"
  shortName String // "Unterer Niederrhein"

  users                        User[]                       @relation("BezirkUsers")
  contentScopes                UserBezirkScope[]
  people                       BezirkPerson[] // Obleute & Stellvertretung shown publicly
  events                       Event[] // Events in this district
  courses                      Course[] // Courses in this district
  posts                        Post[] // Posts for this district
  ensembles                    Ensemble[]
  posaunenwartResponsibilities PosaunenwartResponsibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([number])
}

/**
 * Ein öffentlich gelistetes Bezirksamt (Obmann/Obfrau, Stellvertretung).
 * Die Person kann, muss aber kein Benutzerkonto haben: ohne userId zählen die
 * eigenen Felder, mit userId überschreiben gesetzte Felder die Nutzerdaten.
 */
model BezirkPerson {
  id String @id @default(uuid())

  bezirkId String
  bezirk   Bezirk @relation(fields: [bezirkId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("BezirkPersonUser", fields: [userId], references: [id], onDelete: SetNull)

  name    String?
  email   String?
  phone   String?
  street  String?
  zipCode String?
  city    String?
  bio     String? @db.Text

  imageId String?
  image   Media?  @relation("BezirkPersonImage", fields: [imageId], references: [id], onDelete: SetNull)

  // Role label as shown publicly, e.g. "Bezirksobmann", "Stell. Bezirksobfrau"
  roleName  String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bezirkId, userId])
  @@index([bezirkId])
  @@index([userId])
  @@index([sortOrder])
}

model Posaunenwart {
  id String @id @default(uuid())

  userId String? @unique
  user   User?   @relation("PosaunenwartUser", fields: [userId], references: [id], onDelete: SetNull)

  // Used as-is without a linked user, otherwise overrides the user's data.
  name      String?
  email     String?
  phone     String?
  bio       String? @db.Text
  roleLabel String? // Badge text, e.g. "Landesposaunenwart"; falls back to roleType

  roleType  PosaunenwartRoleType
  sortOrder Int                  @default(0)

  imageId String? @unique
  image   Media?  @relation("PosaunenwartImage", fields: [imageId], references: [id], onDelete: SetNull)

  responsibilities PosaunenwartResponsibility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleType])
  @@index([sortOrder])
}

/**
 * Bezirke, für die ein Nutzer Inhalte anlegen und pflegen darf.
 * Bewusst getrennt von `User.bezirkId`: das ist die Organisationszugehörigkeit
 * und trägt zusammen mit `districtRoleName` ein öffentlich sichtbares Amt
 * ("Bezirksobmann"). Wer ausnahmsweise für einen Bezirk schreiben darf, soll
 * dadurch nicht zum Obmann werden — und umgekehrt kann jemand für mehrere
 * Bezirke zuständig sein, ohne dass die Zugehörigkeit mehrdeutig wird.
 * Der Eintrag allein erlaubt nichts; er schneidet nur zu, worauf die
 * Anlage-Berechtigungen wirken (siehe lib/district-scope.ts).
 */
model UserBezirkScope {
  id String @id @default(uuid())

  userId String
  user   User   @relation("UserBezirkScopes", fields: [userId], references: [id], onDelete: Cascade)

  bezirkId String
  bezirk   Bezirk @relation(fields: [bezirkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, bezirkId])
  @@index([userId])
  @@index([bezirkId])
}

model PosaunenwartResponsibility {
