model HistoryEvent {
  id          String           @id @default(uuid())
  year        Int
  title       String
  description String
  category    HistoryCategory?

  imageId  String?
  image    Media?  @relation("HistoryEventImage", fields: [imageId], references: [id], onDelete: SetNull)
  imageAlt String?

  // Sorting
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
}

model Download {
  id          String           @id @default(uuid())
  title       String
  description String?
  category    DownloadCategory

  // File Info
  fileUrl  String
  fileType FileType
  fileSize Int? // bytes (changed from string to int)

  // Tags
  tags Json? // JSON array

  // Visibility & Review
  isPublic    Boolean       @default(true)
  status      ContentStatus @default(PENDING)
  reviewNotes String?

  // Uploaded by
  uploadedById String?
  uploadedBy   User?   @relation("DownloadUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  // Relations
  events EventDownload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([uploadedById])
