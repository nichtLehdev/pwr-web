  image   Media?  @relation("AuswahlChorImage", fields: [imageId], references: [id], onDelete: SetNull)

  showApplication Boolean @default(false)

  conductorId String?
  conductor   User?   @relation("AuswahlChorConductor", fields: [conductorId], references: [id], onDelete: SetNull)
  events      Event[]

