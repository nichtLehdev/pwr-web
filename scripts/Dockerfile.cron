# =============================================================================
# Cron sidecar: registration-deadline overview e-mails (HTTP → app API)
# =============================================================================

FROM alpine:3.21

RUN apk add --no-cache dcron curl

WORKDIR /scripts

COPY scripts/cron-registration-closed-scheduler.sh /scripts/cron-registration-closed-scheduler.sh
RUN chmod +x /scripts/cron-registration-closed-scheduler.sh

RUN mkdir -p /var/log

ENTRYPOINT ["/scripts/cron-registration-closed-scheduler.sh"]
