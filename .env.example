# =============================================================================
# Posaunenwerk Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values.
#
# QUICK START (Docker):
#   1. Copy: cp .env.example .env
#   2. Set POSTGRES_PASSWORD to a secure password
#   3. Set BETTER_AUTH_SECRET (generate with: openssl rand -base64 32)
#   4. (Optional) Set GitHub OAuth credentials for GitHub login
#   5. Run: docker compose up -d
#   6. (Optional) Seed database: docker compose run --rm --profile seed db-seed
#   7. Open: http://localhost:3000
#
# QUICK START (Local Development):
#   1. Copy: cp .env.example .env
#   2. Start database: ./start-database.sh (or use Docker Desktop)
#   3. Set BETTER_AUTH_SECRET (generate with: openssl rand -base64 32)
#   4. Run: pnpm install && pnpm db:migrate && pnpm dev
#   5. Open: http://localhost:3000
#
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# These are used by Docker Compose to configure PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_use_secure_password
POSTGRES_DB=posaunenwerk
POSTGRES_PORT=5432

# =============================================================================
# Application Configuration
# =============================================================================
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# For production (use HTTPS!):
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# =============================================================================
# Authentication - Better Auth (REQUIRED!)
# =============================================================================
# Generate a secure secret (REQUIRED):
#   Linux/macOS: openssl rand -base64 32
#   Windows (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
BETTER_AUTH_SECRET=

# Base URL for Better Auth (usually same as NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (optional, required for GitHub login)
# Create OAuth App at: https://github.com/settings/developers
# Set callback URL to: http://localhost:3000/api/auth/callback/github
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=

# =============================================================================
# Database URL
# =============================================================================
# For local development (without Docker):
DATABASE_URL=postgresql://postgres:password@localhost:5432/posaunenwerk

# Note: When using Docker Compose, DATABASE_URL is automatically configured
# using the POSTGRES_* variables above. You don't need to change this.
