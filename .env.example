# =============================================================================
# Posaunenwerk Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running docker compose
#
# QUICK START (Docker):
#   1. Copy this file: cp .env.example .env
#   2. Fill in BETTER_AUTH_SECRET (generate with: openssl rand -base64 32)
#   3. Fill in GitHub OAuth credentials
#   4. Run: docker compose up -d
#   5. (Optional) Seed database: docker compose run --rm --profile seed db-seed
#
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=posaunenwerk
POSTGRES_PASSWORD=posaunenwerk_password
POSTGRES_DB=posaunenwerk
POSTGRES_PORT=5432

# =============================================================================
# Application Configuration
# =============================================================================
APP_PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# For production with domain (use HTTPS!):
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# =============================================================================
# Authentication - Better Auth (REQUIRED!)
# =============================================================================
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth (required for GitHub login)
# Create at: https://github.com/settings/developers
# Set callback URL to: http://localhost:3000/api/auth/callback/github
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# =============================================================================
# Database URL (auto-configured by Docker Compose)
# =============================================================================
# For local development (without Docker):
DATABASE_URL="postgresql://postgres:password@localhost:5432/posaunenwerk"
# For Docker (uncomment when using docker-compose):
# DATABASE_URL="postgresql://posaunenwerk:posaunenwerk_password@db:5432/posaunenwerk"
