# =============================================================================
# Posaunenwerk Environment Variables
# =============================================================================
# Copy this file to .env and configure the values for your environment
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=posaunenwerk

# Database URL (for local development, use the Docker service name)
# For Docker Compose: postgresql://postgres:password@posaunenwerk-db:5432/posaunenwerk
# For external database: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:your-secure-password-here@posaunenwerk-db:5432/posaunenwerk

# =============================================================================
# Database Backup Configuration
# =============================================================================
# Nur für docker compose (Service db-backup). Auf mittwald übernimmt die
# Plattform die Backups — dort haben diese beiden Werte keine Wirkung.
#
# Backup schedule in cron format (default: daily at 2 AM)
# Examples:
#   "0 2 * * *"     - Daily at 2 AM
#   "0 */6 * * *"   - Every 6 hours
#   "0 0 * * 0"     - Weekly on Sunday at midnight
#   "0 2 * * 1"     - Weekly on Monday at 2 AM
BACKUP_SCHEDULE=0 2 * * *

# Number of days to keep backups (default: 30)
BACKUP_RETENTION_DAYS=30

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Welches Deployment: "development" | "next" (Pre-Release) | "production".
# Nur "production" ist die öffentliche Seite; sonst wird u. a. das Beta-Banner
# angezeigt. Default: development.
# Auf mittwald steht der Wert fest in deploy/stack.yaml — hier nur für lokale
# Tests der Produktionsdarstellung setzen.
APP_ENV=development

# Log-Ausführlichkeit: debug | info | warn | error | silent.
# Default: "warn" bei NODE_ENV=production, sonst "debug". Ein unbekannter Wert
# fällt auf den Default zurück und legt die App nicht lahm.
# LOG_LEVEL=debug

# Public URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Better Auth Configuration
# =============================================================================
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Base URL for authentication (usually same as NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# GitHub Integration (feedback page -> GitHub issues)
# =============================================================================
# Optional: leave both unset to disable the feedback page entirely — it then
# redirects to /kontakt (production behavior; beta sets these).
# Format: owner/repository
GITHUB_REPO=

# GitHub Personal Access Token with issue write access to that repository
GITHUB_TOKEN=

# =============================================================================
# SMTP Configuration (for email sending)
# =============================================================================
# Optional: SMTP server for sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMTP connection pool. Match these to what your relay allows per mailbox —
# a newsletter blast holds SMTP_MAX_CONNECTIONS connections open at once, and
# anything the relay rejects is never retried.
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES_PER_SECOND=5

# Empfänger des öffentlichen Kontaktformulars. Ohne Wert geht die Nachricht an
# info@posaunenwerk-rheinland.de (Fallback in src/server/api/routers/contact.ts).
# Nur setzen, wenn ein anderes Postfach zuständig sein soll.
CONTACT_EMAIL=

# E-Mail des Benutzers, der beim Post-Migration-Setup die Administrator-Rolle
# bekommt (prisma/post-migration-setup.ts). Ohne Wert wird der Schritt
# übersprungen — auf einer frischen Datenbank hat dann niemand Dashboard-Zugriff.
# Der Benutzer muss bereits registriert sein; sonst listet das Skript die
# vorhandenen Benutzer auf und bricht diesen Schritt ab.
ADMIN_EMAIL=

# Secret for scheduled jobs (registration-closed overview mails,
# newsletter-cleanup). Ohne Wert antworten die /api/cron/*-Routen mit 401 —
# die Jobs laufen dann nie.
# Auf mittwald rufen die mStudio-Cronjobs die Routen mit diesem Bearer-Token
# auf; in docker compose übernimmt das der registration-closed-cron-Service.
# Generate your own: openssl rand -base64 32 — never reuse a value that was
# ever committed to this file.
# Manual test: curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-domain/api/cron/registration-closed
CRON_SECRET=

# =============================================================================
# Wartungsmodus
# =============================================================================
# Harte Übersteuerung. "true" schließt die öffentliche Seite unabhängig von
# der Datenbank — der Schalter für ein Deployment-Fenster, der auch während
# einer Migration greift. Abschalten heißt hier: Wert entfernen und Stack neu
# ausrollen. Für den Alltag gibt es den Schalter im Dashboard unter
# System & Verwaltung -> Wartungsmodus, der ohne Redeploy wirkt.
# MAINTENANCE_MODE=true

# Geheimnis für den Freischaltlink:
#   /api/maintenance/bypass?token=<Wert>
# Setzt ein Cookie, mit dem die echte Seite auch im Wartungsmodus sichtbar ist —
# ohne Anmeldung, also auch für jemanden ohne Konto. "?token=aus" löscht es.
# Ohne gesetzten Wert gibt es keinen Freischaltlink; angemeldete Personen mit
# Dashboard-Zugriff kommen ohnehin durch.
# Erzeugen: openssl rand -hex 24
MAINTENANCE_BYPASS_TOKEN=

# Directory for uploaded files (defaults to ./uploads, outside of public/
# so access always goes through the authorizing /api/uploads route)
# UPLOADS_DIR=/app/uploads

# Cron schedule for registration-closed-cron container (default: every 6 hours).
# Nur für docker compose. Auf mittwald steht der Zeitplan im mStudio-Cronjob.
REGISTRATION_CLOSED_CRON_SCHEDULE=0 */6 * * *


