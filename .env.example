# =============================================================================
# Posaunenwerk Environment Variables
# =============================================================================
# Copy this file to .env and configure the values for your environment
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=posaunenwerk

# Database URL (for local development, use the Docker service name)
# For Docker Compose: postgresql://postgres:password@posaunenwerk-db:5432/posaunenwerk
# For external database: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:your-secure-password-here@posaunenwerk-db:5432/posaunenwerk

# =============================================================================
# Database Backup Configuration
# =============================================================================
# Backup schedule in cron format (default: daily at 2 AM)
# Examples:
#   "0 2 * * *"     - Daily at 2 AM
#   "0 */6 * * *"   - Every 6 hours
#   "0 0 * * 0"     - Weekly on Sunday at midnight
#   "0 2 * * 1"     - Weekly on Monday at 2 AM
BACKUP_SCHEDULE=0 2 * * *

# Number of days to keep backups (default: 30)
BACKUP_RETENTION_DAYS=30

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Welches Deployment: "development" | "next" (Pre-Release) | "production".
# Nur "production" ist die öffentliche Seite; sonst wird u. a. das Beta-Banner
# angezeigt. Default: development.
# APP_ENV=production

# Public URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Better Auth Configuration
# =============================================================================
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Base URL for authentication (usually same as NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# GitHub Integration (feedback page -> GitHub issues)
# =============================================================================
# Optional: leave both unset to disable the feedback page entirely — it then
# redirects to /kontakt (production behavior; beta sets these).
# Format: owner/repository
GITHUB_REPO=

# GitHub Personal Access Token with issue write access to that repository
GITHUB_TOKEN=

# =============================================================================
# SMTP Configuration (for email sending)
# =============================================================================
# Optional: SMTP server for sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMTP connection pool. Match these to what your relay allows per mailbox —
# a newsletter blast holds SMTP_MAX_CONNECTIONS connections open at once, and
# anything the relay rejects is never retried.
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES_PER_SECOND=5

# Secret for scheduled jobs (registration-closed overview mails).
# Required when using the registration-closed-cron service in docker compose.
# Generate your own: openssl rand -base64 32 — never reuse a value that was
# ever committed to this file.
# Manual test: curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-domain/api/cron/registration-closed
CRON_SECRET=

# Directory for uploaded files (defaults to ./uploads, outside of public/
# so access always goes through the authorizing /api/uploads route)
# UPLOADS_DIR=/app/uploads

# Cron schedule for registration-closed-cron container (default: every 6 hours)
REGISTRATION_CLOSED_CRON_SCHEDULE=0 */6 * * *


